# flowlyst-website environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# See docs/development.md for the full local setup walkthrough.

# --- Required to run the app locally ---

# Postgres connection string.
# Local dev (matches docker-compose.yml): postgres://flowlyst:flowlyst@localhost:5432/flowlyst
# In CI this points at the Postgres service container; in production it is the Neon
# connection string (Tural provisions Neon — issue #5 — and sets this in Vercel).
DATABASE_URL=postgres://flowlyst:flowlyst@localhost:5432/flowlyst

# Payload signing secret (encrypts auth tokens, etc.). Generate a unique random
# value per environment: `openssl rand -hex 32`. Never commit a real value.
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_HERE

# --- CMS (issue #4) — optional to boot; set in staging/prod. See docs/cms.md ---
# BLOB_READ_WRITE_TOKEN=     # Vercel Blob media storage. Set by Vercel Blob; absent -> local filesystem.
# CRON_SECRET=               # Secures GET /api/payload-jobs/run for scheduled publishing (Vercel Cron).
# PREVIEW_SECRET=            # Draft-preview secret — REQUIRED for preview (NO fallback). Unset -> preview denied.

# --- Added by later issues (leave unset for now) ---
# LEAD_NOTIFY_TO=            # default recipient for demo/contact/speaking notifications (per-form SALES_/CONTACT_/SPEAKING_NOTIFY_TO override)
# LEAD_NOTIFY_BCC=           # comma-separated BCC on demo/contact/speaking notifications (not the newsletter confirmation); unset = no BCC
# RESEND_API_KEY=            # transactional email (forms) — decided in issue #1, wired later

# --- Spam protection (optional) ---
# Google reCAPTCHA v3 on the demo, contact, speaking and newsletter forms (ADR 0002).
# If either key is absent, reCAPTCHA is off: no script, no attribution, no verification.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=   # public; inlined at build time
# RECAPTCHA_SECRET_KEY=             # server-side verification
# RECAPTCHA_MIN_SCORE=0.3           # optional; scores below this are rejected (0 to 1)
# RECAPTCHA_SITEVERIFY_URL=         # LOCAL TESTING ONLY (points siteverify at the fake server); ignored in production

# --- Zoho Bigin CRM (optional; ADR 0004, docs/runbooks/bigin-setup.md) ---
# Verified leads are pushed to Bigin only when all three credentials are set. Placeholders only.
# BIGIN_CLIENT_ID=<zoho client id>
# BIGIN_CLIENT_SECRET=<zoho client secret>
# BIGIN_REFRESH_TOKEN=<zoho refresh token>
# BIGIN_ACCOUNTS_URL=https://accounts.zoho.com   # your data center's accounts domain
# BIGIN_API_DOMAIN=https://www.zohoapis.com      # optional; defaults to the token answer
# BIGIN_PIPELINE_NAME=Sales Pipeline
# BIGIN_PIPELINE_ID=<pipeline id>                # recommended
# BIGIN_STAGE=Form Submitted
# BIGIN_SUB_PIPELINE_DEMO=sales
# BIGIN_SUB_PIPELINE_CONTACT=sales
# BIGIN_SUB_PIPELINE_SPEAKING=Keynotes
# BIGIN_LEAD_SOURCE_FIELD=                       # deal field API name; unset = not sent
# BIGIN_LEAD_SOURCE_DEMO=Website – Demo
# BIGIN_LEAD_SOURCE_CONTACT=Website – Contact
# BIGIN_LEAD_SOURCE_SPEAKING=Website – Speaking
# BIGIN_PRODUCT_INTEREST_FIELD=                  # deal multi-select field API name; unset = not sent
# BIGIN_PRODUCT_INTEREST_VALUES=                 # JSON overriding the picklist text per key
# BIGIN_CLOSING_DAYS=30
